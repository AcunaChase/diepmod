{
  "manifest_version": 3,
  "name": "Hexlock",
  "version": "1.0",
  "description": "Mod menu for diep.io",
  "icons": { "16": "icon16.png", "48": "icon48.png", "128": "icon128.png" },
  "permissions": ["storage"],
  "host_permissions": ["https://diep.io/*"],
  "content_scripts": [
    {
      "matches": ["https://diep.io/*"],
      "js": ["scanner-wasm.js", "content.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}